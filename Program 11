Question: Write a C++ program that takes the remaining exam time in minutes as input. If 5 minutes or less remain, display "Warning: Exam Is About to End".

#include <iostream>
using namespace std;

int main()
{
    int time;

    cout << "Enter remaining time: ";
    cin >> time;

    if (time <= 5)
    {
        cout << "Warning: Exam Is About to End";
    }

    return 0;
}