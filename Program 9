Question: Write a C++ program that takes a bank account's current balance as input. If the balance is below Rs. 5,000, display "Minimum Balance Alert".

#include <iostream>
using namespace std;

int main()
{
    int balance;

    cout << "Enter account balance: ";
    cin >> balance;

    if (balance < 5000)
    {
        cout << "Minimum Balance Alert";
    }

    return 0;
}