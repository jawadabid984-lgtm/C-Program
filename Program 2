Question: Write a C++ program that takes the total shopping amount as input. If the amount is Rs. 3,000 or more, display "Congratulations! You Qualify for Free Delivery".

#include <iostream>
using namespace std;

int main()
{
    int amount;

    cout << "Enter shopping amount: ";
    cin >> amount;

    if (amount >= 3000)
    {
        cout << "Congratulations! You Qualify for Free Delivery";
    }

    return 0;
}