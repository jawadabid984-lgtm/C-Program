Question: Write a C++ program that takes the number of overdue days as input. If a book is returned after its due date, display "Late Return: Fine Applicable".

#include <iostream>
using namespace std;

int main()
{
    int days;

    cout << "Enter overdue days: ";
    cin >> days;

    if (days > 0)
    {
        cout << "Late Return: Fine Applicable";
    }

    return 0;
}